{
  "name": "@orbitpay/sdk",
  "version": "0.1.0",
  "description": "OrbitPay TypeScript SDK",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node init && tsup src/index.ts --format cjs,esm --dts",
    "dev": "node init && tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
